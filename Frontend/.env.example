# Copy to .env.local for local dev and fill in real values (from Supabase
# Project Settings → API). For prod, set the same two vars in Vercel's
# Project Settings → Environment Variables — both are meant to be public
# (the anon key is safe to expose by design; Row Level Security in
# supabase/schema.sql is what actually protects the data).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=example
