SECRET_KEY=example
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DJANGO_SUPERUSER_USERNAME=example
DJANGO_SUPERUSER_PASSWORD=example
SESSION_COOKIE_SECURE=example
CSRF_COOKIE_SECURE=example
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Postgres connection string — leave unset for local dev (falls back to
# sqlite). Render injects this automatically when a database is attached.
DATABASE_URL=example

# Cloud storage for uploaded media (see core/settings.py's USE_S3 block).
# Leave USE_S3 unset/False for local dev — uploads stay on local disk.
USE_S3=False
AWS_ACCESS_KEY_ID=example
AWS_SECRET_ACCESS_KEY=example
AWS_STORAGE_BUCKET_NAME=example
AWS_S3_ENDPOINT_URL=https://s3.us-west-004.backblazeb2.com
AWS_S3_REGION_NAME=us-west-004
